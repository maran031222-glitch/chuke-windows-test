{
  "name": "chuke-windows-preview",
  "version": "0.28.1",
  "private": true,
  "description": "初刻 Windows 交互预览安装版（演示数据，不连接生产账号）",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "38.0.0",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.chuke.windows.preview",
    "productName": "初刻 Windows 预览版",
    "asar": true,
    "files": ["main.js", "preload.js", "src/index.html", "assets/chuke-app-icon.png", "assets/chuke-app-icon.ico", "package.json"],
    "directories": {"output":"dist"},
    "win": {"target": [{"target":"nsis","arch":["x64"]}], "icon": "assets/chuke-app-icon.ico","signAndEditExecutable":false},
    "nsis": {"oneClick":false,"perMachine":false,"allowToChangeInstallationDirectory":true,"createDesktopShortcut":true,"createStartMenuShortcut":true,"runAfterFinish":true},
    "artifactName": "Chuke-Windows-Preview-${version}-${arch}-Setup.${ext}"
  }
}